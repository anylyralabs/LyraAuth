APP_NAME=LyraAuth
APP_ENV=dev
APP_URL=http://localhost:9501
APP_KEY=

# 安装状态：false 表示尚未初始化管理员与签名密钥
APP_INSTALLED=false

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyraauth
DB_USERNAME=lyraauth
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=127.0.0.1
REDIS_AUTH=change-me
REDIS_PORT=6379
REDIS_DB=0

SESSION_COOKIE_NAME=lyraauth_session
SESSION_LIFETIME=720
SESSION_IDLE_TIMEOUT=120

MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls = STARTTLS（587）；ssl = 隐式 TLS（465）；留空 = 明文（仅内网）
MAIL_ENCRYPTION=tls
# 是否校验服务器证书；自签证书的内网服务器可设为 false
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=no-reply@lyraauth.local
MAIL_FROM_NAME=LyraAuth

# OAuth2 / OIDC
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_AUTH_CODE_TTL=60
OAUTH_DEVICE_CODE_TTL=600
OAUTH_ISSUER=http://localhost:9501

# 认证方式：login = 用户名密码；xoauth2 = 微软 OAuth2（Outlook 个人邮箱必须用这个）
MAIL_AUTH_METHOD=login
