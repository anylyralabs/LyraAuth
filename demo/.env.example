# 应用地址（必须与客户端注册的 redirect_uri 前缀一致）
DEMO_BASE_URL=http://192.168.8.211:9502
DEMO_PORT=9502

# IdP 地址
DEMO_ISSUER=http://192.168.8.211:9501

# 在 LyraAuth 管理后台或命令行创建的客户端
# 创建命令：
#   php bin/hyperf.php oauth:client:create \
#     --name="LyraAuth Demo" \
#     --redirect="http://192.168.8.211:9502/callback" \
#     --post-logout="http://192.168.8.211:9502/" \
#     --allow-private-http
DEMO_CLIENT_ID=
DEMO_CLIENT_SECRET=

# 申请的 scope
DEMO_SCOPES=openid profile email

# 会话签名密钥（仅演示用；生产环境务必替换为随机值）
DEMO_SESSION_SECRET=demo-session-secret-change-me
